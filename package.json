{
  "name": "moth-fight-club",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run test && npm run build",
    "test:smoke": "vitest run src/application.smoke.test.ts src/game/world.smoke.test.ts"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@fontsource/chewy": "^5.3.0",
    "cannon-es": "0.20.0",
    "lil-gui": "0.20.0",
    "three": "0.187.0"
  }
}
